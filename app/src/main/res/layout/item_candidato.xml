<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="3dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">

        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circulo_icono">

            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_menu_candidatos"/>
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/txtNombreCandidato" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/texto_primario" android:textSize="16sp" android:fontFamily="sans-serif-medium" tools:text="Camila Rojas"/>

            <TextView android:id="@+id/txtListaCandidato" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/texto_secundario" android:textSize="13sp" tools:text="Lista A - Renovación"/>

            <TextView android:id="@+id/txtEleccionCandidato" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/dorado_acento" android:textSize="12sp" tools:text="Centro de Alumnos 2026"/>
        </LinearLayout>

        <ImageButton android:id="@+id/btnEditarCandidato" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/accion_editar" android:src="@drawable/ic_edit"/>

        <ImageButton android:id="@+id/btnEliminarCandidato" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:background="@android:color/transparent" android:contentDescription="@string/accion_eliminar" android:src="@drawable/ic_delete"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
