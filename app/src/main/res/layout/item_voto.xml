<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="3dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">

        <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circulo_icono">

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_votar" app:tint="@color/azul_primario"/>
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/txtNombreVoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/texto_primario" android:textSize="15sp" android:fontFamily="sans-serif-medium" tools:text="Camila Rojas"/>

            <TextView android:id="@+id/txtDetalleVoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/texto_secundario" android:textSize="12sp" tools:text="Centro de Alumnos 2026 · 15-10-2026 09:32"/>
        </LinearLayout>

        <ImageButton android:id="@+id/btnEliminarVoto" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/accion_eliminar" android:src="@drawable/ic_delete"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
